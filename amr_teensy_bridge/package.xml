<?xml version="1.0"?>
<package format="2">
  <name>amr_teensy_bridge</name>
  <version>0.0.1</version>
  <description>
    ROS1 (Noetic) bridge between the Jetson and the Teensy 4.0 for mecanum drive,
    handling /cmd_vel commands and publishing odometry and IMU data.
  </description>

  <maintainer email="you@example.com">amr_user</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>tf</build_depend>
  <build_depend>std_msgs</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python-serial</exec_depend>

  <export>
  </export>
</package>

