<?xml version="1.0"?>
<package format="2">
  <name>amr_autonomous_mapping</name>
  <version>0.0.1</version>
  <description>
    Mode 2: LiDAR-only 2D SLAM for manual mapping with odometry from LiDAR pose + MPU6050 IMU.
    Keeps the same launch entrypoint under amr_autonomous_mapping.
  </description>

  <maintainer email="you@example.com">amr_user</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>tf</build_depend>
  <build_depend>tf2_ros</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>hector_mapping</exec_depend>
  <exec_depend>amr_teensy_bridge</exec_depend>
  <exec_depend>amr_description</exec_depend>
  <exec_depend>amr_sensors</exec_depend>
</package>
