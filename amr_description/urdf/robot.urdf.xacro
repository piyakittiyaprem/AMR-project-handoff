<?xml version="1.0"?>
<robot name="mecanum_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== -->
  <!-- Parameters / Constants -->
  <!-- ===================== -->
  <xacro:property name="base_length" value="0.42"/>   <!-- X -->
  <xacro:property name="base_width"  value="0.315"/>  <!-- Y -->
  <xacro:property name="base_height" value="0.105"/>  <!-- Z -->
  <xacro:property name="base_mass"   value="5.0"/>

  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width"  value="0.05"/>
  <xacro:property name="wheel_mass"   value="0.5"/>

  <xacro:property name="track_width"  value="0.395"/> <!-- lateral separation -->
  <xacro:property name="wheelbase"    value="0.30"/>  <!-- longitudinal separation -->

  <xacro:property name="tower_x"      value="0.02"/>
  <xacro:property name="tower_y"      value="0.02"/>
  <xacro:property name="tower_z"      value="0.395"/>
  <xacro:property name="tower_mass"   value="1.0"/>

  <!-- Derived positions -->
  <xacro:property name="half_track"   value="${track_width/2.0}"/>
  <xacro:property name="half_wheelbase" value="${wheelbase/2.0}"/>

  <!-- Base_link center is at wheel_radius + base_height/2 above ground -->
  <xacro:property name="base_center_z" value="${wheel_radius + base_height/2.0}"/>

  <!-- Top of chassis box above base_link center -->
  <xacro:property name="chassis_top_offset_z" value="${base_height/2.0}"/>
  <!-- Tower center above base_link center: box top + tower_z/2 -->
  <xacro:property name="tower_center_z" value="${chassis_top_offset_z + tower_z/2.0}"/>

  <!-- ===================== -->
  <!-- Materials             -->
  <!-- ===================== -->
  <material name="gray">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>

  <!-- ===================== -->
  <!-- Root link             -->
  <!-- ===================== -->
  <link name="base_footprint">
    <!-- Massless frame on the ground -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.0001"/>
      <inertia ixx="1e-6" ixy="0.0" ixz="0.0"
               iyy="1e-6" iyz="0.0"
               izz="1e-6"/>
    </inertial>
  </link>

  <!-- ===================== -->
  <!-- Base chassis (base_link) -->
  <!-- ===================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <!-- Box inertia, m=5, 0.42 x 0.315 x 0.105 -->
      <mass value="${base_mass}"/>
      <inertia ixx="0.04594" ixy="0.0" ixz="0.0"
               iyy="0.07809" iyz="0.0"
               izz="0.11484"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- base_footprint -> base_link (fixed, raises chassis above ground) -->
  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${base_center_z}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== -->
  <!-- Vertical tower_link   -->
  <!-- ===================== -->
  <link name="tower_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${tower_mass}"/>
      <!-- Box inertia, 0.02 x 0.02 x 0.395, m=1 -->
      <inertia ixx="0.01304" ixy="0.0" ixz="0.0"
               iyy="0.01304" iyz="0.0"
               izz="0.000067"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${tower_x} ${tower_y} ${tower_z}"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${tower_x} ${tower_y} ${tower_z}"/>
      </geometry>
    </collision>
  </link>

  <!-- Mounted on top center of chassis box -->
  <joint name="base_to_tower_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="tower_link"/>
    <origin xyz="0 0 ${tower_center_z}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== -->
  <!-- Sensor links          -->
  <!-- ===================== -->

  <!-- IMU -->
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0.0" ixz="0.0"
               iyy="1e-5" iyz="0.0"
               izz="1e-5"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.01"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.01"/>
      </geometry>
    </collision>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <!-- Offset from base_link center as specified -->
    <child  link="imu_link"/>
    <origin xyz="0.035 0.04 0.03" rpy="0 0 0"/>
  </joint>

  <!-- LiDAR at very top of tower -->
  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="1e-4" ixy="0.0" ixz="0.0"
               iyy="1e-4" iyz="0.0"
               izz="1e-4"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.04"/>
      </geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="tower_link"/>
    <!-- From tower center to its top: tower_z/2 -->
    <child  link="lidar_link"/>
    <origin xyz="0 0 ${tower_z/2.0}" rpy="0 0 0"/>
  </joint>

  <!-- Standard nav / health-check frame name (alias of lidar_link for TF chain) -->
  <link name="laser">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-9" ixy="0.0" ixz="0.0" iyy="1e-9" iyz="0.0" izz="1e-9"/>
    </inertial>
  </link>
  <joint name="lidar_to_laser" type="fixed">
    <parent link="lidar_link"/>
    <child link="laser"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===================== -->
  <!-- Wheel macro           -->
  <!-- ===================== -->
  <xacro:macro name="mecanum_wheel" params="prefix parent x y z roll pitch yaw">
    <link name="${prefix}_wheel_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <!-- Cylinder inertia, axis along Y -->
        <inertia ixx="0.000417" ixy="0.0" ixz="0.0"
                 iyy="0.000625" iyz="0.0"
                 izz="0.000417"/>
      </inertial>

      <visual>
        <!-- URDF cylinders are Z-axis by default; rotate to match wheel joint axis (Y) -->
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
        </geometry>
        <material name="black"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
        </geometry>
      </collision>
    </link>

    <!-- Revolute joint; rotation about Y (forward X, left Y, up Z) -->
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${parent}"/>
      <child  link="${prefix}_wheel_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="${roll} ${pitch} ${yaw}"/>
      <axis xyz="0 1 0"/>
      <limit effort="50.0" velocity="20.0"/>
      <dynamics friction="0.0" damping="0.0"/>
    </joint>

    <!-- Gazebo friction for wheel surfaces -->
    <gazebo reference="${prefix}_wheel_link">
      <mu1>0.1</mu1>
      <mu2>0.1</mu2>
      <kp>1000000.0</kp>
      <kd>1.0</kd>
      <fdir1>1 0 0</fdir1>
    </gazebo>
  </xacro:macro>

  <!-- ===================== -->
  <!-- Four Mecanum wheels   -->
  <!-- ===================== -->
  <!-- Coordinates relative to base_link center:
       front/back:  +/- half_wheelbase (X)
       left/right:  +/- half_track     (Y)
       wheel center height: wheel_radius (Z in base_footprint frame),
       but base_link is already raised; we specify wheel origin in base_link frame:
       base_link center is at base_center_z above ground,
       so wheel center in base_link frame is (0,0,wheel_radius - base_center_z)
  -->
  <xacro:property name="wheel_center_z_in_base" value="${wheel_radius - base_center_z}"/>

  <!-- Front left (X+, Y+) -->
  <xacro:mecanum_wheel prefix="front_left"
                       parent="base_link"
                       x="${half_wheelbase}"
                       y="${half_track}"
                       z="${wheel_center_z_in_base}"
                       roll="0" pitch="0" yaw="0"/>

  <!-- Front right (X+, Y-) -->
  <xacro:mecanum_wheel prefix="front_right"
                       parent="base_link"
                       x="${half_wheelbase}"
                       y="-${half_track}"
                       z="${wheel_center_z_in_base}"
                       roll="0" pitch="0" yaw="0"/>

  <!-- Rear left (X-, Y+) -->
  <xacro:mecanum_wheel prefix="rear_left"
                       parent="base_link"
                       x="-${half_wheelbase}"
                       y="${half_track}"
                       z="${wheel_center_z_in_base}"
                       roll="0" pitch="0" yaw="0"/>

  <!-- Rear right (X-, Y-) -->
  <xacro:mecanum_wheel prefix="rear_right"
                       parent="base_link"
                       x="-${half_wheelbase}"
                       y="-${half_track}"
                       z="${wheel_center_z_in_base}"
                       roll="0" pitch="0" yaw="0"/>

  <!-- ===================== -->
  <!-- Transmissions (ROS1)  -->
  <!-- ===================== -->

  <transmission name="front_left_wheel_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="front_left_wheel_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="front_left_wheel_motor">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1.0</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="front_right_wheel_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="front_right_wheel_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="front_right_wheel_motor">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1.0</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="rear_left_wheel_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rear_left_wheel_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="rear_left_wheel_motor">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1.0</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="rear_right_wheel_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rear_right_wheel_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="rear_right_wheel_motor">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1.0</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- ===================== -->
  <!-- Gazebo specifics      -->
  <!-- ===================== -->

  <!-- Gazebo visual plugin for base_link (color, etc.) -->
  <gazebo reference="base_link">
    <material>Gazebo/Gray</material>
  </gazebo>

  <!-- Planar move plugin (ROS 1) -->
  <gazebo>
    <plugin name="planar_move_plugin" filename="libgazebo_ros_planar_move.so">
      <robotNamespace>/</robotNamespace>
      <!-- Use base_footprint so TF is odom -> base_footprint -> base_link (nav standard) -->
      <bodyName>base_footprint</bodyName>

      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <odometryRate>50.0</odometryRate>

      <xVelocityP>10.0</xVelocityP>
      <yVelocityP>10.0</yVelocityP>
      <yawVelocityP>10.0</yawVelocityP>
    </plugin>
  </gazebo>

</robot>

