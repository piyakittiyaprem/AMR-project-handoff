Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Name: Tool Properties
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: false
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 10
      Color: 160; 160; 160
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Show Names: false
    - Class: rviz/RobotModel
      Name: RobotModel
      Enabled: true
      Robot Description: robot_description
    - Class: rviz/LaserScan
      Name: Laser
      Enabled: true
      Topic: /scan
      Size (m): 0.03
    - Class: rviz/Map
      Name: Map
      Enabled: true
      Topic: /map
  Global Options:
    Fixed Frame: map
    Frame Rate: 20
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 5.0
      Pitch: 0.7
      Yaw: 0.7

